graph TB
    subgraph ClientTier["PRESENTATION LAYER (Single Page Application - Vanilla HTML5/CSS3/ES6)"]
        direction TB
        subgraph AdminPortal["HR / Admin Portal (role: HR_ADMIN)"]
            A1["Executive Dashboard (Live DB KPIs & Cycles)"]
            A2["Employee Directory (Create, Edit, Search & Salary Revision Modals)"]
            A3["Attendance Manager (HR Record, Edit & Late Filters)"]
            A4["Leave Manager (HR Record, Approve/Reject/Cancel & Overlap Guards)"]
            A5["Payroll Operations (Procedural Single & Bulk Calculation)"]
            A6["Rollback Tester (2-Step Constraint Violation Proof)"]
            A7["Analytical Reports (Attendance Summary, Late Marks, Departmental)"]
            A8["Audit Trail Viewer (Immutable History with Actor & JSON Diffs)"]
        end

        subgraph EmployeePortal["Employee Portal (role: EMPLOYEE - Read-Only)"]
            E1["Personal Dashboard (Own Salary Summary & Recent Logs)"]
            E2["Own Attendance History (Read-Only Timestamps & Late Flags)"]
            E3["Own Leave History (Read-Only HR Status Tracking)"]
            E4["Itemized Salary Slips (Frozen Master & Line-Item Modal + Print)"]
            E5["Strict Read-Only & IDOR Isolation (All Writes & Peer Access Blocked 403)"]
        end
    end

    subgraph BackendTier["APPLICATION & SECURITY LAYER (Node.js v26+ / Express 5.3)"]
        direction TB
        subgraph SecurityMiddleware["Security & RBAC Middleware (src/middleware/auth.js)"]
            M1["authenticateToken + verifyCsrf (Fail-Closed JWT_SECRET, HttpOnly HS256 Cookie, timingSafeEqual CSRF)"]
            M2["requireRole('HR_ADMIN') (403 Gatekeeper on Writes, Reports & Audit)"]
            M3["enforceSelfOrAdmin (Horizontal IDOR Protection)"]
            M4["bcryptjs (10 Salt Rounds Salted Password Hashing)"]
        end

        subgraph APIRoutes["Modular REST API Routers (src/routes/)"]
            R1["/api/auth (/login, /logout, /me, /dashboard)"]
            R2["/api/employees (Directory, Departments, Create & Edit)"]
            R3["/api/salary (Effective-Dated Salary Structures & Revisions)"]
            R4["/api/attendance (Filtered Views, HR Record & Edit)"]
            R5["/api/leaves (Filtered Views, HR Record & Approvals)"]
            R6["/api/payroll (/periods, /, /slip/:id, /process, /test-rollback)"]
            R7["/api/reports (Reports 1-4 & Dashboard KPIs)"]
            R8["/api/audit-logs (Immutable Audit Trail)"]
        end

        DBPool["mysql2 / promise Pool (paytrace_app DML+EXEC, dateStrings: ['DATE'], multipleStatements: false)"]
    end

    subgraph DatabaseTier["DATA PERSISTENCE & ENGINE LAYER (MariaDB 13.0.2 InnoDB)"]
        direction TB
        subgraph StoredLogic["Stored Procedures & Functions (database/security.sql Roles)"]
            P1["sp_calculate_payroll (START TRANSACTION before Snapshot Reads, Proration, Deduction Cap, ROLLBACK Handler)"]
            P2["sp_process_bulk_payroll (Cursor-Driven Batch Loop with Counters)"]
            P3["sp_demonstrate_transaction_rollback (2-Step Probe -> ROLLBACK_VERIFIED)"]
            F1["fn_count_working_days (Mon-Fri Calendar Counter)"]
            F2["fn_calculate_daily_rate (ROUND Gross / Working Days, 2)"]
            F3["fn_calculate_monthly_tds (4 Progressive Income Tax Slabs)"]
        end

        subgraph TriggersIndexes["Integrity Triggers & 4 Phase-3 Indexes"]
            T1["trg_attendance_before_* (Check-Out >= In, Reject Non-Worked Times, Late >09:15:00)"]
            T2["trg_leaves_before_* (Mon-Fri total_days, Approved Overlap & Attendance Guards)"]
            T3["trg_salary_after_* & trg_payrolls_after_insert (JSON Audit Logs w/ @app_actor_id)"]
            I1["idx_attendance_late_lookup (is_late, work_date)"]
            I2["idx_attendance_period_summary (work_date, employee_id, status, is_late)"]
            I3["idx_leaves_emp_status_dates (employee_id, status, start_date, end_date)"]
            I4["idx_salary_emp_effective (employee_id, effective_date)"]
        end

        subgraph RelationalTables["9 Normalized Tables, 3 Views & Roles (paytrace_app / paytrace_reader)"]
        direction LR
            T_CORE["departments, employees, salary_structures"]
            T_OPS["attendance, leaves, payroll_periods"]
            T_PAY["payrolls, payroll_items, audit_logs"]
            V_SEC["Views: vw_employee_self_profile, vw_employee_attendance_summary, vw_employee_payslip_summary"]
        end
    end

    ClientTier -->|"HTTP REST (JSON) | HttpOnly Cookie + X-CSRF-Token"| BackendTier
    BackendTier -->|"mysql2 Pool (paytrace_app) | SQL DML & CALL sp_*()"| DatabaseTier
    StoredLogic --> F1
    StoredLogic --> F2
    StoredLogic --> F3
    StoredLogic --> RelationalTables
    TriggersIndexes -.->|"Fires & Logs"| RelationalTables
