flowchart TD
    Start(["START: POST /api/payroll/process<br/>{ periodId, employeeId? }"]) --> AuthGate{"authenticateToken + verifyCsrf +<br/>requireRole('HR_ADMIN')?"}
    
    AuthGate -- "Unauthorized / Invalid CSRF (401/403)" --> AuthErr["HTTP 401 / 403 Forbidden"]
    AuthGate -- "Authorized" --> SPCall["Express Invokes Stored Procedure:<br/>CALL sp_calculate_payroll()"]

    subgraph Phase1["Phase 1: Pre-Transaction Validation & Atomic Snapshot Start"]
        G1{"1. Processor HR_ADMIN &<br/>Employee ACTIVE?"}
        G2{"2. Period exists?<br/>period_id found"}
        TX_START["START TRANSACTION;<br/>(Snapshot Consistency Boundary)"]
        G3{"3. Duplicate check?<br/>(emp, period) in payrolls"}
        G4{"4. Effective salary lookup?<br/>effective_date <= period_end"}

        E1["Exit 403 / 404:<br/>Invalid actor or inactive employee"]
        E2["Exit 404: Payroll period not found"]
        E3["ROLLBACK & Exit 409:<br/>Duplicate run prevented"]
        E4["ROLLBACK & Exit 422:<br/>No effective salary structure"]
    end

    SPCall --> G1
    G1 -- "Fail" --> E1
    G1 -- "Pass" --> G2
    G2 -- "Fail" --> E2
    G2 -- "Pass" --> TX_START --> G3
    G3 -- "Exists" --> E3
    G3 -- "Pass" --> G4
    G4 -- "Missing" --> E4

    subgraph Phase2["Phase 2: Operational Metrics Aggregation (Inside Transaction)"]
        M1["Attendance: PRESENT(1.0), HALF_DAY(0.5), is_late count"]
        M2["Leaves: Cross-month prorated Mon-Fri via fn_count_working_days()"]
        M3["Unpaid Integration: +1.0 unexcused ABSENT + 0.5 HALF_DAY"]
        M1 --> M2 --> M3
    end

    G4 -- "Found" --> M1

    subgraph Phase3["Phase 3: Financial Calculations & Deduction Capping"]
        C1["gross_earnings = basic_salary + hra + special_allowance"]
        C2["fn_calculate_daily_rate(gross_earnings, working_days)<br/>daily_rate = ROUND(gross / working_days, 2)"]
        C3["Deductions:<br/>unpaid = ROUND(unpaid_days * daily_rate, 2)<br/>late = ROUND((late > 3 ? (late - 3) * 0.5 * daily_rate : 0), 2)"]
        C4["fn_calculate_monthly_tds(gross_earnings * 12.0)<br/>4 Progressive Slabs: 0% / 5% / 10% / 20%"]
        C5["Sequential Cap via v_remaining & LEAST()<br/>net_salary = gross_earnings - total_deductions (>= 0.00)"]
        C1 --> C2 --> C3 --> C4 --> C5
    end

    M3 --> C1

    subgraph Phase4["Phase 4: Atomic Persistence & Commit/Rollback"]
        TX_MASTER["Step 4A: INSERT INTO payrolls<br/>• Trigger trg_payrolls_after_insert -> audit_logs<br/>• Capture LAST_INSERT_ID() -> p_payroll_id"]
        TX_ITEMS["Step 4B: INSERT INTO payroll_items<br/>• Normalized Earnings & Capped Deductions"]
        TX_VERIFY{"InnoDB Constraints & FKs Valid?<br/>chk_payroll_gross/net/items >= 0"}
        TX_COMMIT["COMMIT;<br/>Atomic Persistence to Disk"]
        TX_ROLLBACK["ROLLBACK;<br/>DECLARE EXIT HANDLER FOR SQLEXCEPTION<br/>Zero Orphaned Rows"]

        TX_MASTER --> TX_ITEMS --> TX_VERIFY
        TX_VERIFY -- "Valid" --> TX_COMMIT
        TX_VERIFY -- "SQLEXCEPTION" --> TX_ROLLBACK
    end

    C5 --> TX_MASTER

    Success(["SUCCESS: HTTP 200 OK<br/>Returns { payroll_id, net_salary }"])
    Failure(["FAILURE: HTTP 409 / 422 / 500<br/>Transaction Rolled Back Cleanly"])

    TX_COMMIT --> Success
    TX_ROLLBACK --> Failure
