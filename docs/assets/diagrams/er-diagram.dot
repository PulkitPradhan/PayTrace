digraph PayTrace_ERD {
    graph [
        rankdir=LR,
        bgcolor="#FFFFFF",
        pad="0.5",
        nodesep="0.65",
        ranksep="1.15",
        fontname="Helvetica, Arial, sans-serif",
        fontsize="16",
        splines=spline
    ];
    node [
        shape=none,
        fontname="Helvetica, Arial, sans-serif",
        fontsize="10"
    ];
    edge [
        fontname="Helvetica, Arial, sans-serif",
        fontsize="9",
        color="#475569",
        arrowsize="0.85",
        penwidth=1.5
    ];

    // Graph Title & Metadata
    labelloc="t";
    label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td align="center"><font point-size="20" color="#0F172A"><b>PayTrace — Relational Database Entity-Relationship Diagram</b></font></td></tr>
        <tr><td align="center"><font point-size="11" color="#475569">MariaDB 13.0+ / MySQL 8.0+ (InnoDB Engine) &bull; 9 Normalized Entities (3NF / BCNF) &bull; Academic Capstone Specification</font></td></tr>
        <tr><td align="center"><font point-size="9" color="#64748B"><b>Legend:</b> <font color="#D97706"><b>[PK]</b> Primary Key</font> &nbsp;|&nbsp; <font color="#2563EB"><b>[FK]</b> Foreign Key</font> &nbsp;|&nbsp; <font color="#7C3AED"><b>[UK]</b> Unique Key</font> &nbsp;|&nbsp; <font color="#B45309"><b>[chk]</b> Check Constraint</font> &nbsp;|&nbsp; Solid: Non-Null Reference &nbsp;|&nbsp; Dashed/Dotted: Nullable Reference</font></td></tr>
    </table>>;

    // Subgraph Ranks for optimal visual hierarchy
    { rank=same; departments; payroll_periods; }
    { rank=same; employees; salary_structures; }
    { rank=same; attendance; leaves; payrolls; }
    { rank=same; payroll_items; audit_logs; }

    // 1. DEPARTMENTS
    departments [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#0284C7" colspan="3" align="center"><font color="#FFFFFF"><b>departments</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Organizational Departments</font></td></tr>
            <tr><td align="left" port="dept_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>department_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left"><font color="#7C3AED"><b>UK</b></font></td><td align="left">department_name</td><td align="right"><font color="#64748B">VARCHAR(50)</font></td></tr>
            <tr><td align="left"></td><td align="left">description</td><td align="right"><font color="#64748B">VARCHAR(255)</font></td></tr>
            <tr><td align="left"></td><td align="left">created_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
        </table>
    >];

    // 6. PAYROLL_PERIODS
    payroll_periods [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#7C3AED" colspan="3" align="center"><font color="#FFFFFF"><b>payroll_periods</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Monthly Accounting Cycles</font></td></tr>
            <tr><td align="left" port="period_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>period_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left"><font color="#7C3AED"><b>UK</b></font></td><td align="left">period_name</td><td align="right"><font color="#64748B">VARCHAR(30)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">start_date</td><td align="right"><font color="#64748B">DATE</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">end_date</td><td align="right"><font color="#64748B">DATE</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">total_working_days</td><td align="right"><font color="#64748B">INT</font></td></tr>
            <tr><td align="left"></td><td align="left">status</td><td align="right"><font color="#64748B">ENUM('OPEN',...)</font></td></tr>
            <tr><td align="left"></td><td align="left">created_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
        </table>
    >];

    // 2. EMPLOYEES
    employees [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#1E40AF" colspan="3" align="center"><font color="#FFFFFF"><b>employees</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Master Staff Directory &amp; RBAC</font></td></tr>
            <tr><td align="left" port="emp_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>employee_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left"><font color="#7C3AED"><b>UK</b></font></td><td align="left">employee_code</td><td align="right"><font color="#64748B">VARCHAR(20)</font></td></tr>
            <tr><td align="left"></td><td align="left">first_name</td><td align="right"><font color="#64748B">VARCHAR(50)</font></td></tr>
            <tr><td align="left"></td><td align="left">last_name</td><td align="right"><font color="#64748B">VARCHAR(50)</font></td></tr>
            <tr><td align="left"><font color="#7C3AED"><b>UK</b></font></td><td align="left">email</td><td align="right"><font color="#64748B">VARCHAR(100)</font></td></tr>
            <tr><td align="left"></td><td align="left">phone</td><td align="right"><font color="#64748B">VARCHAR(20)</font></td></tr>
            <tr><td align="left" port="dept_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">department_id</font></td><td align="right"><font color="#64748B">INT</font></td></tr>
            <tr><td align="left"></td><td align="left">designation</td><td align="right"><font color="#64748B">VARCHAR(50)</font></td></tr>
            <tr><td align="left"></td><td align="left">role</td><td align="right"><font color="#64748B">ENUM('HR_ADMIN','EMPLOYEE')</font></td></tr>
            <tr><td align="left"></td><td align="left">password_hash</td><td align="right"><font color="#64748B">VARCHAR(255)</font></td></tr>
            <tr><td align="left"></td><td align="left">hire_date</td><td align="right"><font color="#64748B">DATE</font></td></tr>
            <tr><td align="left"></td><td align="left">status</td><td align="right"><font color="#64748B">ENUM('ACTIVE','INACTIVE','TERMINATED')</font></td></tr>
            <tr><td align="left"></td><td align="left">created_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
            <tr><td align="left"></td><td align="left">updated_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
        </table>
    >];

    // 3. SALARY_STRUCTURES
    salary_structures [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#4338CA" colspan="3" align="center"><font color="#FFFFFF"><b>salary_structures</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Effective-Dated Compensation</font></td></tr>
            <tr><td align="left" port="salary_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>salary_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left" port="emp_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">employee_id</font></td><td align="right"><font color="#64748B">INT</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">basic_salary</td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">hra</td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">special_allowance</td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">provident_fund</td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">professional_tax</td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"></td><td align="left">effective_date</td><td align="right"><font color="#64748B">DATE</font></td></tr>
            <tr><td align="left"></td><td align="left">is_active</td><td align="right"><font color="#64748B">BOOLEAN</font></td></tr>
            <tr><td align="left"></td><td align="left">created_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
            <tr><td align="left"></td><td align="left">updated_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
        </table>
    >];

    // 4. ATTENDANCE
    attendance [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#059669" colspan="3" align="center"><font color="#FFFFFF"><b>attendance</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Daily Time &amp; Late-Mark Tracking</font></td></tr>
            <tr><td align="left" port="att_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>attendance_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left" port="emp_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">employee_id</font></td><td align="right"><font color="#64748B">INT [UK 1/2]</font></td></tr>
            <tr><td align="left"><font color="#7C3AED"><b>UK</b></font></td><td align="left">work_date</td><td align="right"><font color="#64748B">DATE [UK 2/2]</font></td></tr>
            <tr><td align="left"></td><td align="left">status</td><td align="right"><font color="#64748B">ENUM('PRESENT',...)</font></td></tr>
            <tr><td align="left"></td><td align="left">check_in_time</td><td align="right"><font color="#64748B">TIME</font></td></tr>
            <tr><td align="left"></td><td align="left">check_out_time</td><td align="right"><font color="#64748B">TIME</font></td></tr>
            <tr><td align="left"></td><td align="left">is_late</td><td align="right"><font color="#64748B">BOOLEAN</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">late_minutes</td><td align="right"><font color="#64748B">INT</font></td></tr>
            <tr><td align="left"></td><td align="left">remarks</td><td align="right"><font color="#64748B">VARCHAR(255)</font></td></tr>
            <tr><td align="left"></td><td align="left">created_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
            <tr><td align="left"></td><td align="left">updated_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
        </table>
    >];

    // 5. LEAVES
    leaves [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#D97706" colspan="3" align="center"><font color="#FFFFFF"><b>leaves</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Leave Applications &amp; Approvals</font></td></tr>
            <tr><td align="left" port="leave_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>leave_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left" port="emp_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">employee_id</font></td><td align="right"><font color="#64748B">INT (Applicant)</font></td></tr>
            <tr><td align="left"></td><td align="left">leave_type</td><td align="right"><font color="#64748B">ENUM('CASUAL',...)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">start_date</td><td align="right"><font color="#64748B">DATE</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">end_date</td><td align="right"><font color="#64748B">DATE</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">total_days</td><td align="right"><font color="#64748B">DECIMAL(4,1)</font></td></tr>
            <tr><td align="left"></td><td align="left">reason</td><td align="right"><font color="#64748B">VARCHAR(255)</font></td></tr>
            <tr><td align="left"></td><td align="left">status</td><td align="right"><font color="#64748B">ENUM('PENDING',...)</font></td></tr>
            <tr><td align="left"></td><td align="left">applied_on</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
            <tr><td align="left" port="action_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">actioned_by</font></td><td align="right"><font color="#64748B">INT (Approver)</font></td></tr>
            <tr><td align="left"></td><td align="left">actioned_on</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
            <tr><td align="left"></td><td align="left">admin_remarks</td><td align="right"><font color="#64748B">VARCHAR(255)</font></td></tr>
        </table>
    >];

    // 7. PAYROLLS
    payrolls [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#DC2626" colspan="3" align="center"><font color="#FFFFFF"><b>payrolls</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Finalized Salary Master Snapshot</font></td></tr>
            <tr><td align="left" port="payroll_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>payroll_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left" port="emp_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">employee_id</font></td><td align="right"><font color="#64748B">INT [UK 1/2]</font></td></tr>
            <tr><td align="left" port="period_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">period_id</font></td><td align="right"><font color="#64748B">INT [UK 2/2]</font></td></tr>
            <tr><td align="left" port="salary_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">salary_id</font></td><td align="right"><font color="#64748B">INT (Ref Structure)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">present_days</td><td align="right"><font color="#64748B">DECIMAL(4,1)</font></td></tr>
            <tr><td align="left"></td><td align="left">approved_paid_leave_days</td><td align="right"><font color="#64748B">DECIMAL(4,1)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">unpaid_leave_days</td><td align="right"><font color="#64748B">DECIMAL(4,1)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">late_days</td><td align="right"><font color="#64748B">INT</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left"><font color="#059669"><b>gross_earnings</b></font></td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left"><font color="#DC2626"><b>total_deductions</b></font></td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left"><font color="#2563EB"><b>net_salary</b></font></td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"></td><td align="left">payment_status</td><td align="right"><font color="#64748B">ENUM('CALCULATED',...)</font></td></tr>
            <tr><td align="left" port="proc_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">processed_by</font></td><td align="right"><font color="#64748B">INT (HR Actor)</font></td></tr>
            <tr><td align="left"></td><td align="left">processed_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
            <tr><td align="left"></td><td align="left">payment_date</td><td align="right"><font color="#64748B">DATE</font></td></tr>
            <tr><td align="left"></td><td align="left">remarks</td><td align="right"><font color="#64748B">VARCHAR(255)</font></td></tr>
        </table>
    >];

    // 8. PAYROLL_ITEMS
    payroll_items [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#BE123C" colspan="3" align="center"><font color="#FFFFFF"><b>payroll_items</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Normalized Itemized Line Items</font></td></tr>
            <tr><td align="left" port="item_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>item_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left" port="payroll_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">payroll_id</font></td><td align="right"><font color="#64748B">INT</font></td></tr>
            <tr><td align="left"></td><td align="left">item_type</td><td align="right"><font color="#64748B">ENUM('EARNING','DEDUCTION')</font></td></tr>
            <tr><td align="left"></td><td align="left">item_name</td><td align="right"><font color="#64748B">VARCHAR(50)</font></td></tr>
            <tr><td align="left"><font color="#B45309" point-size="7">chk</font></td><td align="left">amount</td><td align="right"><font color="#64748B">DECIMAL(10,2)</font></td></tr>
            <tr><td align="left"></td><td align="left">description</td><td align="right"><font color="#64748B">VARCHAR(255)</font></td></tr>
            <tr><td align="left"></td><td align="left">created_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
        </table>
    >];

    // 9. AUDIT_LOGS
    audit_logs [label=<
        <table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#CBD5E1">
            <tr><td bgcolor="#0F766E" colspan="3" align="center"><font color="#FFFFFF"><b>audit_logs</b></font></td></tr>
            <tr bgcolor="#F8FAFC"><td colspan="3" align="center"><font color="#64748B" point-size="8">Immutable Security Audit Trail</font></td></tr>
            <tr><td align="left" port="log_id"><font color="#D97706"><b>PK</b></font></td><td align="left"><b>log_id</b></td><td align="right"><font color="#64748B">INT AUTO</font></td></tr>
            <tr><td align="left"></td><td align="left">table_name</td><td align="right"><font color="#64748B">VARCHAR(50)</font></td></tr>
            <tr><td align="left"></td><td align="left">record_id</td><td align="right"><font color="#64748B">INT</font></td></tr>
            <tr><td align="left"></td><td align="left">action</td><td align="right"><font color="#64748B">ENUM('INSERT','UPDATE','DELETE')</font></td></tr>
            <tr><td align="left" port="actor_fk"><font color="#2563EB"><b>FK</b></font></td><td align="left"><font color="#1D4ED8">actor_employee_id</font></td><td align="right"><font color="#64748B">INT NULL</font></td></tr>
            <tr><td align="left"></td><td align="left">old_values</td><td align="right"><font color="#64748B">LONGTEXT (JSON)</font></td></tr>
            <tr><td align="left"></td><td align="left">new_values</td><td align="right"><font color="#64748B">LONGTEXT (JSON)</font></td></tr>
            <tr><td align="left"></td><td align="left">ip_address</td><td align="right"><font color="#64748B">VARCHAR(45)</font></td></tr>
            <tr><td align="left"></td><td align="left">created_at</td><td align="right"><font color="#64748B">TIMESTAMP</font></td></tr>
        </table>
    >];

    // Relationships, Cardinalities & Referential Constraints
    departments:dept_id -> employees:dept_fk [
        label=" 1 : N\n [ON DELETE RESTRICT]",
        color="#0284C7",
        fontcolor="#0369A1"
    ];

    employees:emp_id -> salary_structures:emp_fk [
        label=" 1 : N\n [ON DELETE CASCADE]",
        color="#4F46E5",
        fontcolor="#4338CA"
    ];

    employees:emp_id -> attendance:emp_fk [
        label=" 1 : N\n [ON DELETE CASCADE]",
        color="#059669",
        fontcolor="#047857"
    ];

    employees:emp_id -> leaves:emp_fk [
        label=" 1 : N (applicant)\n [ON DELETE CASCADE]",
        color="#D97706",
        fontcolor="#B45309"
    ];

    employees:emp_id -> leaves:action_fk [
        label=" 0..1 : N (approver)\n [ON DELETE SET NULL]",
        color="#D97706",
        fontcolor="#B45309",
        style=dashed
    ];

    payroll_periods:period_id -> payrolls:period_fk [
        label=" 1 : N\n [ON DELETE RESTRICT]",
        color="#7C3AED",
        fontcolor="#6D28D9"
    ];

    employees:emp_id -> payrolls:emp_fk [
        label=" 1 : N (recipient)\n [ON DELETE RESTRICT]",
        color="#DC2626",
        fontcolor="#B91C1C"
    ];

    salary_structures:salary_id -> payrolls:salary_fk [
        label=" 1 : N (snapshot ref)\n [ON DELETE RESTRICT]",
        color="#4F46E5",
        fontcolor="#4338CA"
    ];

    employees:emp_id -> payrolls:proc_fk [
        label=" 1 : N (processed_by)\n [ON DELETE RESTRICT]",
        color="#DC2626",
        fontcolor="#B91C1C",
        style=dashed
    ];

    payrolls:payroll_id -> payroll_items:payroll_fk [
        label=" 1 : N\n [ON DELETE CASCADE]",
        color="#BE123C",
        fontcolor="#9F1239"
    ];

    employees:emp_id -> audit_logs:actor_fk [
        label=" 0..1 : N (actor)\n [ON DELETE SET NULL]",
        color="#0F766E",
        fontcolor="#115E59",
        style=dotted
    ];
}
