digraph PayTrace_Workflow {
    graph [
        rankdir=TB,
        bgcolor="#FFFFFF",
        pad="0.5",
        nodesep="0.55",
        ranksep="0.65",
        fontname="Helvetica, Arial, sans-serif",
        fontsize="16",
        compound=true,
        splines=spline
    ];
    node [
        fontname="Helvetica, Arial, sans-serif",
        fontsize="10"
    ];
    edge [
        fontname="Helvetica, Arial, sans-serif",
        fontsize="9",
        color="#334155",
        penwidth=1.5
    ];

    // Title
    labelloc="t";
    label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="4">
        <tr><td align="center"><font point-size="20" color="#0F172A"><b>PayTrace — Payroll Processing &amp; Transaction Lifecycle</b></font></td></tr>
        <tr><td align="center"><font point-size="11" color="#475569">Procedural Execution Workflow &bull; Stored Functions &bull; ACID Transaction Boundaries &bull; Automated Rollback</font></td></tr>
    </table>>;

    // TOP: INVOCATION
    subgraph cluster_entry {
        label=<<font color="#0369A1" point-size="11"><b>Client Request &amp; Authentication Gate</b></font>>;
        style="filled,rounded";
        fillcolor="#F0F9FF";
        color="#BAE6FD";
        penwidth=1.2;

        start_node [shape=ellipse, style="filled", fillcolor="#0284C7", fontcolor="#FFFFFF", label="START\nHR Admin Initiates Payroll\nPOST /api/payroll/process\n{ periodId, employeeId? }", width=2.4];
        auth_gate [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#0284C7", label="authenticateToken &\nrequireRole('HR_ADMIN')?"];
        auth_fail [shape=rect, style="filled,rounded", fillcolor="#FEE2E2", color="#EF4444", label="HTTP 401 / 403\nUnauthorized / Forbidden"];
        sp_invoke [shape=box3d, style="filled", fillcolor="#E0E7FF", color="#4F46E5", label="Express Backend Invokes Stored Procedure:\nCALL sp_calculate_payroll(p_emp_id, p_period_id, p_admin_id, @pid, @net, @code, @msg)"];

        start_node -> auth_gate;
        auth_gate -> auth_fail [label="No", color="#EF4444", fontcolor="#EF4444"];
        auth_gate -> sp_invoke [label="Authorized", color="#16A34A", fontcolor="#16A34A"];
    }

    // PHASE 1: GUARDS
    subgraph cluster_guards {
        label=<<font color="#B45309" point-size="11"><b>Phase 1: Pre-Transaction Validation &amp; Integrity Guard Clauses (Procedural Checkpoints)</b></font>>;
        style="filled,rounded";
        fillcolor="#FFFBEB";
        color="#FDE68A";
        penwidth=1.2;

        g1 [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#F59E0B", label="1. Employee Active?\nstatus = 'ACTIVE'"];
        g2 [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#F59E0B", label="2. Period Exists?\nperiod_id found"];
        g3 [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#F59E0B", label="3. Duplicate Check?\n(emp, period) in payrolls"];
        g4 [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#F59E0B", label="4. Active Salary Structure?\nis_active = TRUE"];

        err_404_emp [shape=rect, style="filled,rounded", fillcolor="#FEF2F2", color="#F87171", label="Exit 404:\nEmployee inactive/absent"];
        err_404_per [shape=rect, style="filled,rounded", fillcolor="#FEF2F2", color="#F87171", label="Exit 404:\nPeriod not found"];
        err_409_dup [shape=rect, style="filled,rounded", fillcolor="#FEF2F2", color="#F87171", label="Exit 409 Conflict:\nDuplicate run prevented"];
        err_422_sal [shape=rect, style="filled,rounded", fillcolor="#FEF2F2", color="#F87171", label="Exit 422 Unprocessable:\nNo active salary found"];

        g1 -> err_404_emp [label="Fail", color="#EF4444", fontcolor="#EF4444"];
        g1 -> g2 [label="Pass", color="#16A34A"];
        g2 -> err_404_per [label="Fail", color="#EF4444", fontcolor="#EF4444"];
        g2 -> g3 [label="Pass", color="#16A34A"];
        g3 -> err_409_dup [label="Exists", color="#EF4444", fontcolor="#EF4444"];
        g3 -> g4 [label="None", color="#16A34A"];
        g4 -> err_422_sal [label="Missing", color="#EF4444", fontcolor="#EF4444"];
    }

    sp_invoke -> g1 [color="#4F46E5", penwidth=1.8];

    // PHASE 2 & 3: CALCULATION PIPELINE
    subgraph cluster_middle {
        label="";
        color="#FFFFFF";

        subgraph cluster_phase2 {
            label=<<font color="#0369A1" point-size="11"><b>Phase 2: Operational Data Aggregation</b></font>>;
            style="filled,rounded";
            fillcolor="#F0F9FF";
            color="#BAE6FD";
            penwidth=1.2;

            agg_att [shape=rect, style="filled,rounded", fillcolor="#FFFFFF", color="#38BDF8", label="Attendance Table Aggregation:\n• present_days = SUM(PRESENT:1.0, HALF_DAY:0.5)\n• late_days = SUM(is_late = TRUE)"];
            agg_leave [shape=rect, style="filled,rounded", fillcolor="#FFFFFF", color="#38BDF8", label="Leaves Table Aggregation:\n• paid_leave_days = SUM(CASUAL, SICK, PAID)\n• unpaid_leave_days = SUM(UNPAID)"];
            agg_absent [shape=rect, style="filled,rounded", fillcolor="#FFFFFF", color="#38BDF8", label="Absence Mark Integration:\n• unpaid_leave_days += COUNT(status = 'ABSENT')"];

            agg_att -> agg_leave -> agg_absent;
        }

        subgraph cluster_phase3 {
            label=<<font color="#047857" point-size="11"><b>Phase 3: Financial Calculations &amp; Formulas</b></font>>;
            style="filled,rounded";
            fillcolor="#F0FDF4";
            color="#BBF7D0";
            penwidth=1.2;

            calc_gross [shape=rect, style="filled,rounded", fillcolor="#FFFFFF", color="#4ADE80", label="Gross Compensation Calculation:\ngross_earnings = basic_salary + hra + special_allowance"];
            calc_daily [shape=box3d, style="filled", fillcolor="#DCFCE7", color="#22C55E", label="fn_calculate_daily_rate(gross_earnings, working_days)\ndaily_rate = ROUND(gross_earnings / working_days, 2)"];
            calc_deductions [shape=rect, style="filled,rounded", fillcolor="#FFFFFF", color="#4ADE80", label="Deduction Evaluation:\n• unpaid_deduction = ROUND(unpaid_days * daily_rate, 2)\n• late_penalty = (late_days > 3) ? (late_days - 3) * 0.5 * daily_rate : 0.00"];
            calc_tds [shape=box3d, style="filled", fillcolor="#DCFCE7", color="#22C55E", label="fn_calculate_monthly_tds(gross_earnings * 12.0)\n4 Progressive Slabs: 0% / 5% / 10% / 20%\nmonthly_tds = ROUND(annual_tax / 12.0, 2)"];
            calc_net [shape=rect, style="filled,rounded", fillcolor="#DCFCE7", color="#16A34A", label="Net Disbursable Salary:\ntotal_deductions = pf + pt + unpaid_ded + late_pen + monthly_tds\nnet_salary = MAX(0.00, gross_earnings - total_deductions)"];

            calc_gross -> calc_daily -> calc_deductions -> calc_tds -> calc_net;
        }
    }

    g4 -> agg_att [label="Valid", color="#16A34A", penwidth=1.8];
    agg_absent -> calc_gross [color="#0369A1", penwidth=1.8];

    // PHASE 4: ACID TRANSACTION
    subgraph cluster_tx {
        label=<<font color="#991B1B" point-size="12"><b>Phase 4: ACID Transaction Boundary (MariaDB InnoDB Storage Engine)</b></font>>;
        style="filled,rounded";
        fillcolor="#FEF2F2";
        color="#F87171";
        penwidth=1.8;

        tx_start [shape=ellipse, style="filled", fillcolor="#EF4444", fontcolor="#FFFFFF", label="START TRANSACTION;"];

        tx_ins_master [shape=rect, style="filled,rounded", fillcolor="#FFFFFF", color="#DC2626", label="Step 4A: INSERT INTO payrolls\n• Master Metrics: present_days, unpaid_days, late_days\n• Financials: gross_earnings, total_deductions, net_salary\n• Audit Trigger trg_payrolls_after_insert fires &rarr; audit_logs\n• LAST_INSERT_ID() saved as p_payroll_id"];

        tx_ins_items [shape=rect, style="filled,rounded", fillcolor="#FFFFFF", color="#DC2626", label="Step 4B: INSERT INTO payroll_items (Itemized Breakdown)\n• EARNING: Basic Salary, HRA, Special Allowance\n• DEDUCTION: PF, PT, Unpaid Leave, Late Penalty, Income Tax (TDS)"];

        tx_verify [shape=diamond, style="filled", fillcolor="#FFFFFF", color="#DC2626", label="Engine Check Constraints &amp; Integrity:\n• chk_payroll_gross (gross &ge; 0) • chk_payroll_net (net &ge; 0)\n• chk_payroll_item_amount (amount &ge; 0) • FK References Valid?"];

        tx_commit [shape=rect, style="filled,rounded", fillcolor="#DCFCE7", color="#16A34A", penwidth=2.0, label="COMMIT;\nAtomic Persistence to Disk\nAll tables synchronized"];

        tx_rollback [shape=rect, style="filled,rounded", fillcolor="#FEE2E2", color="#B91C1C", penwidth=2.0, label="ROLLBACK;\nDECLARE EXIT HANDLER FOR SQLEXCEPTION\nEntire transaction reverted &bull; Zero orphaned rows"];

        tx_start -> tx_ins_master -> tx_ins_items -> tx_verify;
        tx_verify -> tx_commit [label="Valid (No Violations)", color="#16A34A", fontcolor="#16A34A", penwidth=2.0];
        tx_verify -> tx_rollback [label="Integrity Error / Exception", color="#DC2626", fontcolor="#DC2626", penwidth=2.0, style=dashed];
    }

    calc_net -> tx_start [color="#DC2626", penwidth=2.0];

    // TERMINAL NODES
    subgraph cluster_outcomes {
        label="";
        color="#FFFFFF";

        res_success [shape=ellipse, style="filled", fillcolor="#16A34A", fontcolor="#FFFFFF", label="SUCCESS (HTTP 200 OK)\nSET p_status_code = 200\np_status_message = 'Payroll successfully calculated'\nReturns { payroll_id, net_salary }", width=3.0];
        res_fail [shape=ellipse, style="filled", fillcolor="#B91C1C", fontcolor="#FFFFFF", label="FAILURE (HTTP 500 / SQLEXCEPTION)\nSET p_payroll_id = NULL, p_net_salary = 0.00\np_status_code = 500, p_status_message = 'Transaction aborted'\nReturns { success: false, error }", width=3.0];
    }

    tx_commit -> res_success [color="#16A34A", penwidth=2.0];
    tx_rollback -> res_fail [color="#B91C1C", penwidth=2.0];
}
